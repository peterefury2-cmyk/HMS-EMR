generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SYSTEM_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_SCIENTIST
  RADIOLOGIST
  RECEPTIONIST
  BILLING_OFFICER
  PATIENT
  INSURANCE_PROVIDER
  ENTERPRISE_CLIENT
}

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  GOVERNMENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum VisitType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  TELEMEDICINE
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NoteType {
  SOAP
  NARRATIVE
}

enum AppointmentType {
  IN_PERSON
  TELEMEDICINE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RadiologyOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InsurancePolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InsuranceClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum TelemedicineSessionStatus {
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
  COMPLICATION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  INSURANCE
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum AiSuggestionType {
  DIAGNOSIS
  DRUG_INTERACTION
  RISK_SCORE
  ICD_CODE
  TREATMENT_PLAN
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVIEWED
}

enum PreAuthStatus {
  REQUESTED
  APPROVED
  DENIED
  EXPIRED
}

enum FhirResourceType {
  PATIENT
  ENCOUNTER
  OBSERVATION
  CONDITION
  MEDICATION_REQUEST
  DIAGNOSTIC_REPORT
  ALLERGY_INTOLERANCE
  BUNDLE
}

enum IcdVersion {
  ICD_10
  ICD_11
}

enum SampleType {
  BLOOD
  URINE
  STOOL
  SPUTUM
  SWAB
  TISSUE
  OTHER
}

enum SampleStatus {
  COLLECTED
  RECEIVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum QueuePriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  PET
  MAMMOGRAPHY
  FLUOROSCOPY
  NUCLEAR
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  invoices             Invoice[]
  drugs                Drug[]
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  labTests             LabTest[]
  radiologyOrders      RadiologyOrder[]
  insurancePolicies    InsurancePolicy[]
  insuranceClaims      InsuranceClaim[]
  telemedicineSessions TelemedicineSession[]
  subscription         Subscription?
  auditLogs            AuditLog[]
  visits               Visit[]
  departments          Department[]
  branches             TenantBranch[]
  notifications        Notification[]
  aiSuggestions        AiSuggestion[]
  usageRecords         UsageRecord[]
  featureFlags         FeatureFlag[]
  fhirResourceLogs     FhirResourceLog[]
  preAuthorizations    PreAuthorization[]
  queueEntries         QueueEntry[]
  insuranceProviders   InsuranceProvider[]

  @@map("tenants")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  headId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("departments")
}

model TenantBranch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_branches")
}

model User {
  id                String   @id @default(cuid())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  email             String   @unique
  passwordHash      String
  role              Role     @default(DOCTOR)
  firstName         String
  lastName          String
  isActive          Boolean  @default(true)
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctorVisits    Visit[]         @relation("DoctorVisits")
  prescribedMeds  Medication[]
  clinicalNotes   ClinicalNote[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  auditLogs       AuditLog[]
  sessions        Session[]
  notifications   Notification[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  patientNo        String
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           Gender
  phone            String
  email            String?
  address          String?
  bloodGroup       BloodGroup?
  genotype         String?
  emergencyContact Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  visits            Visit[]
  appointments      Appointment[]
  medications       Medication[]
  allergies         Allergy[]
  invoices          Invoice[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  insurancePolicies InsurancePolicy[]
  nextOfKin         PatientNextOfKin[]
  medicalHistories  MedicalHistory[]
  consentRecords    ConsentRecord[]
  queueEntries      QueueEntry[]
  aiSuggestions     AiSuggestion[]

  @@unique([tenantId, patientNo])
  @@index([tenantId])
  @@index([createdAt])
  @@map("patients")
}

model PatientNextOfKin {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId])
  @@map("patient_next_of_kin")
}

model MedicalHistory {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  condition   String
  icdCode     String?
  onsetDate   DateTime?
  resolvedDate DateTime?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@map("medical_histories")
}

model ConsentRecord {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  type        String
  isConsented Boolean
  notes       String?
  signedAt    DateTime @default(now())

  @@index([patientId])
  @@map("consent_records")
}

model Visit {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         User        @relation("DoctorVisits", fields: [doctorId], references: [id])
  type           VisitType   @default(OUTPATIENT)
  chiefComplaint String
  status         VisitStatus @default(SCHEDULED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  clinicalNotes   ClinicalNote[]
  diagnoses       Diagnosis[]
  vitalSigns      VitalSigns[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  attachments     Attachment[]
  aiSuggestions   AiSuggestion[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("visits")
}

model ClinicalNote {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id])
  type        NoteType @default(SOAP)
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clinical_notes")
}

model Diagnosis {
  id            String        @id @default(cuid())
  visitId       String
  visit         Visit         @relation(fields: [visitId], references: [id])
  icdCode       String
  description   String
  type          DiagnosisType @default(PRIMARY)
  icdVersion    IcdVersion    @default(ICD_10)
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())

  @@index([visitId])
  @@map("diagnoses")
}

model VitalSigns {
  id                     String   @id @default(cuid())
  visitId                String
  visit                  Visit    @relation(fields: [visitId], references: [id])
  temperature            Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  respiratoryRate        Int?
  oxygenSaturation       Float?
  weight                 Float?
  height                 Float?
  bmi                    Float?
  recordedAt             DateTime @default(now())

  @@map("vital_signs")
}

model Attachment {
  id          String   @id @default(cuid())
  visitId     String?
  visit       Visit?   @relation(fields: [visitId], references: [id])
  tenantId    String
  name        String
  url         String
  mimeType    String
  size        Int
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([visitId])
  @@map("attachments")
}

model Allergy {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  allergen    String
  reaction    String?
  severity    Severity @default(MODERATE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@map("allergies")
}

model Medication {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  name         String
  dosage       String
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  prescribedBy String
  prescriber   User     @relation(fields: [prescribedBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@map("medications")
}

model DoctorSchedule {
  id          String   @id @default(cuid())
  doctorId    String
  tenantId    String
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int      @default(30)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doctorId])
  @@index([tenantId])
  @@map("doctor_schedules")
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  scheduledAt DateTime
  duration    Int               @default(30)
  type        AppointmentType   @default(IN_PERSON)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  telemedicineSession TelemedicineSession?
  queueEntry          QueueEntry?

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

model QueueEntry {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  queueNumber   Int
  priority      QueuePriority @default(NORMAL)
  status        QueueStatus   @default(WAITING)
  calledAt      DateTime?
  servedAt      DateTime?
  createdAt     DateTime      @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("queue_entries")
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])
  invoiceNo   String        @unique
  subtotal    Decimal       @db.Decimal(10, 2) @default(0)
  taxAmount   Decimal       @db.Decimal(10, 2) @default(0)
  discount    Decimal       @db.Decimal(10, 2) @default(0)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      InvoiceStatus @default(DRAFT)
  items       Json
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  gateway   String?
  status    PaymentStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

model Drug {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  name             String
  genericName      String?
  category         String
  unit             String
  stock            Int       @default(0)
  reorderLevel     Int       @default(10)
  expiryDate       DateTime?
  batchNumber      String?
  price            Decimal   @db.Decimal(10, 2)
  isControlled     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  prescriptionItems  PrescriptionItem[]
  interactionsFrom   DrugInteraction[]  @relation("DrugA")
  interactionsTo     DrugInteraction[]  @relation("DrugB")

  @@index([tenantId])
  @@map("drugs")
}

model DrugInteraction {
  id          String   @id @default(cuid())
  drugAId     String
  drugA       Drug     @relation("DrugA", fields: [drugAId], references: [id])
  drugBId     String
  drugB       Drug     @relation("DrugB", fields: [drugBId], references: [id])
  severity    Severity
  description String
  recommendation String?
  createdAt   DateTime @default(now())

  @@unique([drugAId, drugBId])
  @@map("drug_interactions")
}

model Prescription {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  visitId      String
  visit        Visit              @relation(fields: [visitId], references: [id])
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id])
  pharmacistId String?
  status       PrescriptionStatus @default(PENDING)
  dispensedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  drugId         String
  drug           Drug         @relation(fields: [drugId], references: [id])
  quantity       Int
  dosage         String
  frequency      String
  duration       String

  @@map("prescription_items")
}

model LabTest {
  id             String  @id @default(cuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  name           String
  code           String
  loincCode      String?
  category       String
  referenceRange String?
  unit           String?
  price          Decimal @db.Decimal(10, 2)

  labOrderItems LabOrderItem[]

  @@index([tenantId])
  @@map("lab_tests")
}

model LabOrder {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  visitId        String
  visit          Visit          @relation(fields: [visitId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  labScientistId String?
  labScientist   User?          @relation(fields: [labScientistId], references: [id])
  status         LabOrderStatus @default(PENDING)
  priority       QueuePriority  @default(NORMAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items   LabOrderItem[]
  samples LabSample[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("lab_orders")
}

model LabSample {
  id          String       @id @default(cuid())
  labOrderId  String
  labOrder    LabOrder     @relation(fields: [labOrderId], references: [id])
  barcode     String       @unique
  sampleType  SampleType
  status      SampleStatus @default(COLLECTED)
  collectedAt DateTime     @default(now())
  receivedAt  DateTime?
  notes       String?

  @@index([labOrderId])
  @@map("lab_samples")
}

model LabOrderItem {
  id             String    @id @default(cuid())
  labOrderId     String
  labOrder       LabOrder  @relation(fields: [labOrderId], references: [id])
  labTestId      String
  labTest        LabTest   @relation(fields: [labTestId], references: [id])
  result         String?
  numericResult  Float?
  unit           String?
  isAbnormal     Boolean   @default(false)
  isCritical     Boolean   @default(false)
  status         String    @default("PENDING")
  reportedAt     DateTime?

  @@map("lab_order_items")
}

model RadiologyOrder {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  visitId       String
  visit         Visit                @relation(fields: [visitId], references: [id])
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id])
  radiologistId String?
  radiologist   User?                @relation(fields: [radiologistId], references: [id])
  modality      ImagingModality
  bodyPart      String
  indication    String?
  status        RadiologyOrderStatus @default(PENDING)
  report        String?
  isCritical    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  dicomStudies DicomStudy[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("radiology_orders")
}

model DicomStudy {
  id               String         @id @default(cuid())
  radiologyOrderId String
  radiologyOrder   RadiologyOrder @relation(fields: [radiologyOrderId], references: [id])
  studyUid         String         @unique
  studyDate        DateTime
  accessionNumber  String?
  pacsUrl          String?
  createdAt        DateTime       @default(now())

  @@map("dicom_studies")
}

model InsuranceProvider {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  contactEmail String?
  contactPhone String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies         InsurancePolicy[]
  preAuthorizations PreAuthorization[]

  @@index([tenantId])
  @@map("insurance_providers")
}

model InsurancePolicy {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient               @relation(fields: [patientId], references: [id])
  providerId   String
  provider     InsuranceProvider     @relation(fields: [providerId], references: [id])
  policyNo     String
  coverageType String
  maxCoverage  Decimal?              @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  status       InsurancePolicyStatus @default(ACTIVE)

  claims            InsuranceClaim[]
  preAuthorizations PreAuthorization[]

  @@index([tenantId])
  @@index([patientId])
  @@map("insurance_policies")
}

model PreAuthorization {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  policyId    String
  policy      InsurancePolicy @relation(fields: [policyId], references: [id])
  providerId  String
  provider    InsuranceProvider @relation(fields: [providerId], references: [id])
  authCode    String?
  procedure   String
  amount      Decimal       @db.Decimal(10, 2)
  status      PreAuthStatus @default(REQUESTED)
  requestedAt DateTime      @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?
  notes       String?

  @@index([tenantId])
  @@index([status])
  @@map("pre_authorizations")
}

model InsuranceClaim {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  invoiceId   String
  invoice     Invoice              @relation(fields: [invoiceId], references: [id])
  policyId    String
  policy      InsurancePolicy      @relation(fields: [policyId], references: [id])
  claimNo     String               @unique
  amount      Decimal              @db.Decimal(10, 2)
  approvedAmount Decimal?          @db.Decimal(10, 2)
  status      InsuranceClaimStatus @default(SUBMITTED)
  submittedAt DateTime             @default(now())
  approvedAt  DateTime?
  rejectionReason String?

  @@index([tenantId])
  @@index([status])
  @@map("insurance_claims")
}

model TelemedicineSession {
  id            String                    @id @default(cuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  appointmentId String                    @unique
  appointment   Appointment               @relation(fields: [appointmentId], references: [id])
  roomId        String                    @unique
  status        TelemedicineSessionStatus @default(WAITING)
  startedAt     DateTime?
  endedAt       DateTime?
  durationMin   Int?

  chatMessages ChatMessage[]

  @@map("telemedicine_sessions")
}

model ChatMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   TelemedicineSession @relation(fields: [sessionId], references: [id])
  senderId  String
  message   String
  type      String              @default("TEXT")
  sentAt    DateTime            @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model Notification {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  recipient String
  subject   String?
  message   String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model AiSuggestion {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  patientId   String?
  patient     Patient?           @relation(fields: [patientId], references: [id])
  visitId     String?
  visit       Visit?             @relation(fields: [visitId], references: [id])
  type        AiSuggestionType
  status      AiSuggestionStatus @default(PENDING)
  input       Json
  output      Json
  confidence  Float?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([tenantId])
  @@index([patientId])
  @@index([createdAt])
  @@map("ai_suggestions")
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  plan                   TenantPlan
  status                 SubscriptionStatus @default(ACTIVE)
  startDate              DateTime
  endDate                DateTime
  amount                 Decimal            @db.Decimal(10, 2)
  currency               String             @default("USD")
  interval               String             @default("MONTHLY")
  stripeSubscriptionId   String?
  paystackSubscriptionId String?

  usageRecords UsageRecord[]

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  feature        String
  quantity       Int      @default(1)
  recordedAt     DateTime @default(now())

  @@index([tenantId])
  @@index([recordedAt])
  @@map("usage_records")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  feature   String
  plan      TenantPlan?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature])
  @@map("feature_flags")
}

model FhirResourceLog {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  resourceType FhirResourceType
  resourceId   String
  fhirJson     Json
  version      Int             @default(1)
  createdAt    DateTime        @default(now())

  @@index([tenantId])
  @@index([resourceType])
  @@map("fhir_resource_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}
