generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SYSTEM_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_SCIENTIST
  RADIOLOGIST
  RECEPTIONIST
  BILLING_OFFICER
  PATIENT
  INSURANCE_PROVIDER
  ENTERPRISE_CLIENT
}

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  GOVERNMENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum VisitType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  TELEMEDICINE
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NoteType {
  SOAP
  NARRATIVE
}

enum AppointmentType {
  IN_PERSON
  TELEMEDICINE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RadiologyOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InsurancePolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InsuranceClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum TelemedicineSessionStatus {
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum AiSuggestionType {
  DIAGNOSIS
  DRUG_INTERACTION
  RISK_SCORE
  ICD_CODING
  TREATMENT_PLAN
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PreAuthStatus {
  REQUESTED
  APPROVED
  DENIED
  EXPIRED
}

enum FhirResourceType {
  PATIENT
  ENCOUNTER
  OBSERVATION
  CONDITION
  MEDICATION_REQUEST
  DIAGNOSTIC_REPORT
  ALLERGY_INTOLERANCE
  IMMUNIZATION
  PROCEDURE
}

enum IcdVersion {
  ICD_10
  ICD_11
}

enum SampleType {
  BLOOD
  URINE
  STOOL
  SPUTUM
  CSF
  SWAB
  TISSUE
  OTHER
}

enum SampleStatus {
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum QueuePriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  MAMMOGRAPHY
  FLUOROSCOPY
  PET_CT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  invoices             Invoice[]
  drugs                Drug[]
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  labTests             LabTest[]
  radiologyOrders      RadiologyOrder[]
  insurancePolicies    InsurancePolicy[]
  insuranceClaims      InsuranceClaim[]
  telemedicineSessions TelemedicineSession[]
  subscription         Subscription?
  auditLogs            AuditLog[]
  visits               Visit[]
  departments          Department[]
  branches             TenantBranch[]
  queueEntries         QueueEntry[]
  notifications        Notification[]
  usageRecords         UsageRecord[]
  fhirResourceLogs     FhirResourceLog[]
  preAuthorizations    PreAuthorization[]
  insuranceProviders   InsuranceProvider[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role     @default(DOCTOR)
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  failedLogins Int      @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorVisits    Visit[]          @relation("DoctorVisits")
  prescribedMeds  Medication[]
  clinicalNotes   ClinicalNote[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  auditLogs       AuditLog[]
  doctorSchedules DoctorSchedule[]
  notifications   Notification[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  patientNo        String
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  phone            String
  email            String?
  address          String?
  bloodGroup       String?
  genotype         String?
  emergencyContact Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  visits            Visit[]
  appointments      Appointment[]
  medications       Medication[]
  allergies         Allergy[]
  invoices          Invoice[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  insurancePolicies InsurancePolicy[]
  nextOfKin         PatientNextOfKin[]
  medicalHistories  MedicalHistory[]
  consentRecords    ConsentRecord[]
  queueEntries      QueueEntry[]

  @@unique([tenantId, patientNo])
  @@index([tenantId])
  @@index([createdAt])
  @@map("patients")
}

model Visit {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         User        @relation("DoctorVisits", fields: [doctorId], references: [id])
  type           VisitType   @default(OUTPATIENT)
  chiefComplaint String
  status         VisitStatus @default(SCHEDULED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  clinicalNotes   ClinicalNote[]
  diagnoses       Diagnosis[]
  vitalSigns      VitalSigns[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  attachments     Attachment[]
  aiSuggestions   AiSuggestion[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("visits")
}

model ClinicalNote {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id])
  type        NoteType @default(SOAP)
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clinical_notes")
}

model Diagnosis {
  id            String        @id @default(cuid())
  visitId       String
  visit         Visit         @relation(fields: [visitId], references: [id])
  icdCode       String
  description   String
  status        String        @default("ACTIVE")
  diagnosisType DiagnosisType @default(PRIMARY)
  createdAt     DateTime      @default(now())

  @@index([visitId])
  @@map("diagnoses")
}

model VitalSigns {
  id                     String   @id @default(cuid())
  visitId                String
  visit                  Visit    @relation(fields: [visitId], references: [id])
  temperature            Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  respiratoryRate        Int?
  oxygenSaturation       Float?
  weight                 Float?
  height                 Float?
  bmi                    Float?
  recordedAt             DateTime @default(now())

  @@index([visitId])
  @@map("vital_signs")
}

model Allergy {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  allergen  String
  reaction  String?
  severity  String   @default("MODERATE")
  createdAt DateTime @default(now())

  @@index([patientId])
  @@map("allergies")
}

model Medication {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  name         String
  dosage       String
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  prescribedBy String
  prescriber   User      @relation(fields: [prescribedBy], references: [id])
  createdAt    DateTime  @default(now())

  @@map("medications")
}

model Appointment {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctorId     String
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  scheduledAt  DateTime
  duration     Int               @default(30)
  type         AppointmentType   @default(IN_PERSON)
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  telemedicineSession TelemedicineSession?

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

model Invoice {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id])
  invoiceNo String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  subtotal  Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount Decimal       @default(0) @db.Decimal(10, 2)
  discount  Decimal       @default(0) @db.Decimal(10, 2)
  currency  String        @default("USD")
  status    InvoiceStatus @default(DRAFT)
  items     Json
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  gateway   String?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

model Drug {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  genericName  String?
  category     String
  unit         String
  stock        Int       @default(0)
  reorderLevel Int       @default(10)
  expiryDate   DateTime?
  price        Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prescriptionItems   PrescriptionItem[]
  drugInteractionsA   DrugInteraction[]  @relation("DrugInteractionA")
  drugInteractionsB   DrugInteraction[]  @relation("DrugInteractionB")

  @@index([tenantId])
  @@map("drugs")
}

model Prescription {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  visitId      String
  visit        Visit              @relation(fields: [visitId], references: [id])
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id])
  pharmacistId String?
  status       PrescriptionStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([tenantId])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  drugId         String
  drug           Drug         @relation(fields: [drugId], references: [id])
  quantity       Int
  dosage         String
  frequency      String
  duration       String

  @@map("prescription_items")
}

model LabTest {
  id             String  @id @default(cuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  name           String
  code           String
  loincCode      String?
  category       String
  referenceRange String?
  unit           String?
  price          Decimal @db.Decimal(10, 2)

  labOrderItems LabOrderItem[]

  @@index([tenantId])
  @@map("lab_tests")
}

model LabOrder {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  visitId        String
  visit          Visit          @relation(fields: [visitId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  labScientistId String?
  labScientist   User?          @relation(fields: [labScientistId], references: [id])
  status         LabOrderStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items      LabOrderItem[]
  labSamples LabSample[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("lab_orders")
}

model LabOrderItem {
  id         String    @id @default(cuid())
  labOrderId String
  labOrder   LabOrder  @relation(fields: [labOrderId], references: [id])
  labTestId  String
  labTest    LabTest   @relation(fields: [labTestId], references: [id])
  result     String?
  unit       String?
  isAbnormal Boolean?
  status     String    @default("PENDING")
  reportedAt DateTime?

  @@map("lab_order_items")
}

model RadiologyOrder {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  visitId       String
  visit         Visit                @relation(fields: [visitId], references: [id])
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id])
  radiologistId String?
  radiologist   User?                @relation(fields: [radiologistId], references: [id])
  modality      String
  bodyPart      String
  indication    String?
  status        RadiologyOrderStatus @default(PENDING)
  report        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  dicomStudies DicomStudy[]

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("radiology_orders")
}

model InsurancePolicy {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient               @relation(fields: [patientId], references: [id])
  providerId   String
  provider     InsuranceProvider?    @relation(fields: [providerId], references: [id])
  policyNo     String
  coverageType String
  startDate    DateTime
  endDate      DateTime
  status       InsurancePolicyStatus @default(ACTIVE)

  claims            InsuranceClaim[]
  preAuthorizations PreAuthorization[]

  @@index([tenantId])
  @@index([patientId])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  invoiceId   String
  invoice     Invoice              @relation(fields: [invoiceId], references: [id])
  policyId    String
  policy      InsurancePolicy      @relation(fields: [policyId], references: [id])
  claimNo     String               @unique
  amount      Decimal              @db.Decimal(10, 2)
  status      InsuranceClaimStatus @default(SUBMITTED)
  submittedAt DateTime             @default(now())
  approvedAt  DateTime?

  @@index([tenantId])
  @@index([status])
  @@map("insurance_claims")
}

model TelemedicineSession {
  id            String                    @id @default(cuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  appointmentId String                    @unique
  appointment   Appointment               @relation(fields: [appointmentId], references: [id])
  roomId        String                    @unique
  status        TelemedicineSessionStatus @default(WAITING)
  startedAt     DateTime?
  endedAt       DateTime?
  recordingUrl  String?

  chatMessages ChatMessage[]

  @@map("telemedicine_sessions")
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  plan                   TenantPlan
  status                 SubscriptionStatus @default(ACTIVE)
  startDate              DateTime
  endDate                DateTime
  amount                 Decimal            @db.Decimal(10, 2)
  currency               String             @default("USD")
  interval               String             @default("MONTHLY")
  stripeSubscriptionId   String?
  paystackSubscriptionId String?

  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── New Models ───────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  queueEntries QueueEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model TenantBranch {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  address        String?
  phone          String?
  email          String?
  isHeadquarters Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_branches")
}

model PatientNextOfKin {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String?
  address      String?
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@map("patient_next_of_kin")
}

model DoctorSchedule {
  id           String   @id @default(cuid())
  doctorId     String
  doctor       User     @relation(fields: [doctorId], references: [id])
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model QueueEntry {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id])
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  queueNumber  Int
  priority     QueuePriority @default(NORMAL)
  status       QueueStatus   @default(WAITING)
  checkedInAt  DateTime      @default(now())
  calledAt     DateTime?
  completedAt  DateTime?

  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@map("queue_entries")
}

model MedicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition     String
  diagnosedDate DateTime?
  status        String    @default("ACTIVE")
  notes         String?
  isChronic     Boolean   @default(false)
  familyHistory Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
  @@map("medical_histories")
}

model Attachment {
  id         String   @id @default(cuid())
  visitId    String
  visit      Visit    @relation(fields: [visitId], references: [id])
  fileName   String
  fileType   String
  fileUrl    String
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([visitId])
  @@map("attachments")
}

model DrugInteraction {
  id             String   @id @default(cuid())
  drugAId        String
  drugA          Drug     @relation("DrugInteractionA", fields: [drugAId], references: [id])
  drugBId        String
  drugB          Drug     @relation("DrugInteractionB", fields: [drugBId], references: [id])
  severity       Severity
  description    String
  recommendation String?
  createdAt      DateTime @default(now())

  @@map("drug_interactions")
}

model LabSample {
  id              String       @id @default(cuid())
  labOrderId      String
  labOrder        LabOrder     @relation(fields: [labOrderId], references: [id])
  sampleType      SampleType
  barcode         String       @unique
  collectedBy     String
  collectedAt     DateTime     @default(now())
  receivedAt      DateTime?
  status          SampleStatus @default(COLLECTED)
  rejectionReason String?

  @@index([labOrderId])
  @@map("lab_samples")
}

model DicomStudy {
  id               String         @id @default(cuid())
  radiologyOrderId String
  radiologyOrder   RadiologyOrder @relation(fields: [radiologyOrderId], references: [id])
  studyInstanceUid String         @unique
  seriesCount      Int            @default(0)
  imageCount       Int            @default(0)
  storageUrl       String?
  createdAt        DateTime       @default(now())

  @@map("dicom_studies")
}

model InsuranceProvider {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies InsurancePolicy[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("insurance_providers")
}

model PreAuthorization {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  policyId        String
  policy          InsurancePolicy @relation(fields: [policyId], references: [id])
  visitId         String?
  requestedAmount Decimal         @db.Decimal(10, 2)
  approvedAmount  Decimal?        @db.Decimal(10, 2)
  status          PreAuthStatus   @default(REQUESTED)
  reason          String?
  requestedAt     DateTime        @default(now())
  decidedAt       DateTime?
  decidedBy       String?

  @@index([tenantId])
  @@index([status])
  @@map("pre_authorizations")
}

model Notification {
  id        String             @id @default(cuid())
  tenantId  String?
  tenant    Tenant?            @relation(fields: [tenantId], references: [id])
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model AiSuggestion {
  id         String             @id @default(cuid())
  visitId    String
  visit      Visit              @relation(fields: [visitId], references: [id])
  type       AiSuggestionType
  suggestion Json
  confidence Float
  reasoning  String?
  status     AiSuggestionStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([visitId])
  @@map("ai_suggestions")
}

model UsageRecord {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  metric     String
  quantity   Float
  recordedAt DateTime @default(now())

  @@index([tenantId])
  @@index([recordedAt])
  @@map("usage_records")
}

model FeatureFlag {
  id      String     @id @default(cuid())
  plan    TenantPlan
  feature String
  enabled Boolean    @default(true)
  limit   Int?

  @@unique([plan, feature])
  @@map("feature_flags")
}

model ConsentRecord {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  consentType String
  granted     Boolean
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  document    String?

  @@index([patientId])
  @@map("consent_records")
}

model FhirResourceLog {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  resourceType FhirResourceType
  resourceId   String
  fhirId       String           @unique
  version      Int              @default(1)
  payload      Json
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@map("fhir_resource_logs")
}

model ChatMessage {
  id          String              @id @default(cuid())
  sessionId   String
  session     TelemedicineSession @relation(fields: [sessionId], references: [id])
  senderId    String
  content     String
  messageType String              @default("TEXT")
  fileUrl     String?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
